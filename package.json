{
  "name": "markdown-viewer",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/desktop",
    "dev:desktop": "npm run dev:desktop -w apps/desktop",
    "phone": "npm run phone -w apps/mobile --",
    "release": "node scripts/release.mjs",
    "build:desktop": "npm run build:desktop -w apps/desktop",
    "tauri": "npm run tauri -w apps/desktop --",
    "icon": "npm run icon -w apps/desktop",
    "lint": "oxlint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify": "oxlint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "feedback": "node ../feedback-kit/cli/feedback.mjs",
    "vault:check": "tsx packages/core/scripts/vault-check.ts",
    "base:check": "tsx packages/core/scripts/base-check.ts",
    "sync:device": "tsx packages/sync/scripts/device.ts",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "oxlint": "^1.83.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
