{
  "name": "markdown-viewer",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/desktop",
    "dev:desktop": "npm run dev:desktop -w apps/desktop",
    "build:desktop": "npm run build:desktop -w apps/desktop",
    "tauri": "npm run tauri -w apps/desktop --",
    "icon": "npm run icon -w apps/desktop",
    "lint": "oxlint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify": "oxlint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "feedback": "node services/feedback/scripts/feedback.mjs"
  },
  "devDependencies": {
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
