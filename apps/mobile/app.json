{
  "expo": {
    "name": "markdown-viewer",
    "slug": "markdown-viewer",
    "version": "0.8.0",
    "scheme": "markdown-viewer",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050508",
    "android": {
      "package": "ai.artell.markdownviewer",
      "adaptiveIcon": {
        "backgroundColor": "#050508",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "react-native-libsodium",
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera lê o QR de pareamento mostrado pelo desktop.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
