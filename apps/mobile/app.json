{
  "expo": {
    "name": "Markdown Viewer",
    "slug": "markdown-viewer",
    "version": "0.16.0",
    "scheme": "markdown-viewer",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050508",
    "android": {
      "package": "ai.artell.markdownviewer",
      "adaptiveIcon": {
        "backgroundColor": "#07061c",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [
            {
              "mimeType": "text/plain"
            }
          ]
        },
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [
            {
              "mimeType": "image/*"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": ["DEFAULT"],
          "data": [
            {
              "mimeType": "image/*"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            {
              "scheme": "content",
              "mimeType": "text/markdown"
            },
            {
              "scheme": "content",
              "mimeType": "text/x-markdown"
            },
            {
              "scheme": "content",
              "mimeType": "text/plain"
            },
            {
              "scheme": "file",
              "mimeType": "text/markdown"
            },
            {
              "scheme": "file",
              "mimeType": "text/x-markdown"
            },
            {
              "scheme": "file",
              "mimeType": "text/plain"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07061c",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "react-native-libsodium",
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera lê o QR de pareamento e tira as fotos que entram nas notas.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "A câmera tira a foto que entra na nota.",
          "photosPermission": "As fotos escolhidas entram na nota.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "ota": {
        "repo": "megomes/markdown-viewer",
        "tagPrefix": "android-v",
        "asset": "markdown-viewer-(\\d+)\\.apk"
      }
    }
  }
}
