<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/quick_capture_item"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/quick_capture_card"
  android:orientation="horizontal">

  <ImageView
    android:id="@+id/quick_capture_item_bar"
    android:layout_width="3dp"
    android:layout_height="match_parent"
    android:layout_marginStart="8dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    android:background="@color/quick_capture_accent" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="9dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
      android:id="@+id/quick_capture_item_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/quick_capture_text"
      android:textSize="14sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/quick_capture_item_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="5"
      android:textColor="@color/quick_capture_text_secondary"
      android:textSize="13sp" />
  </LinearLayout>
</LinearLayout>
