<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/quick_capture_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/quick_capture_bg"
  android:orientation="vertical"
  android:padding="10dp">

  <!-- The top: the app's mark and name, which open it, and the button that writes a note. -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/quick_capture_open"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="4dp">

      <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/quick_capture_open"
        android:src="@drawable/quick_capture_logo" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/quick_capture_widget_name"
        android:textColor="@color/quick_capture_text"
        android:textSize="16sp"
        android:textStyle="bold" />
    </LinearLayout>

    <ImageView
      android:id="@+id/quick_capture_new"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:background="@drawable/quick_capture_plus_bg"
      android:contentDescription="@string/quick_capture_new"
      android:padding="9dp"
      android:src="@drawable/quick_capture_plus" />
  </LinearLayout>

  <ListView
    android:id="@+id/quick_capture_list"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="8dp"
    android:layout_weight="1"
    android:divider="@android:color/transparent"
    android:dividerHeight="6dp"
    android:scrollbars="none" />

  <TextView
    android:id="@+id/quick_capture_empty"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center"
    android:padding="12dp"
    android:text="@string/quick_capture_empty"
    android:textColor="@color/quick_capture_text_tertiary"
    android:textSize="13sp" />
</LinearLayout>
