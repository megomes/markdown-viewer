<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- The widget on the home screen: pinned notes and a button to write one. -->
    <receiver
      android:name=".NotesWidgetProvider"
      android:exported="true"
      android:label="@string/quick_capture_widget_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/quick_capture_widget_info" />
    </receiver>
    <service
      android:name=".NotesWidgetService"
      android:exported="false"
      android:permission="android.permission.BIND_REMOTEVIEWS" />
  </application>
</manifest>
